# =========================================================
# MathSnap — Environment Variables
# Copy to .env.local (in this nextjs-app/ folder) and fill in real values.
# Never commit .env.local.
# =========================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=                 # Supabase project URL — Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # Supabase anon/public key — Settings > API
SUPABASE_SERVICE_ROLE_KEY=                # SERVER ONLY — Settings > API. Trusted server-side operations only; never expose to the client.

# Anthropic (vision-parse, solve-agent, follow-up steps)
ANTHROPIC_API_KEY=                        # SERVER ONLY — console.anthropic.com > API Keys
ANTHROPIC_MODEL=claude-sonnet-5           # Model id used across the AI pipeline

# Symbolic Verification Service (SymPy)
SYMPY_VERIFY_SERVICE_URL=                 # SERVER ONLY — internal URL of the verification microservice. Leave blank in local dev — verify.ts treats an unreachable/unset service as "unverifiable", not a hard failure.
SYMPY_VERIFY_SERVICE_TOKEN=               # SERVER ONLY — shared secret authenticating requests to the verification service

# Stripe (billing)
STRIPE_SECRET_KEY=                        # SERVER ONLY — dashboard.stripe.com > Developers > API keys
STRIPE_WEBHOOK_SECRET=                    # SERVER ONLY — dashboard.stripe.com > Developers > Webhooks (signing secret for /api/billing/webhook)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=       # dashboard.stripe.com > Developers > API keys
STRIPE_PRICE_ID_MONTHLY=                  # Price ID for the $9.99/month plan — dashboard.stripe.com > Products
STRIPE_PRICE_ID_ANNUAL=                   # Price ID for the $59.99/year plan — dashboard.stripe.com > Products

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=                   # SERVER ONLY — console.upstash.com > your database > REST API. Leave blank in local dev — rateLimit.ts no-ops when unset.
UPSTASH_REDIS_REST_TOKEN=                 # SERVER ONLY — console.upstash.com > your database > REST API

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000 # Full deployed URL — used for Stripe/OAuth redirect URLs
SOLVE_CONFIDENCE_THRESHOLD=0.75           # Minimum vision-parse confidence (0-1) required to attempt a solve; below this, user is prompted to retake/crop
DAILY_FREE_SOLVE_LIMIT=5                  # Number of solves/day allowed on the free tier
MAX_CHAT_HISTORY=20                       # Max prior follow-up messages replayed to the model as context per solve
